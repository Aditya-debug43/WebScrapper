# =============================================================================
# Mulya frontend — environment
#
# Copy to .env.local (git-ignored) and adjust. Only variables prefixed with
# VITE_ reach the browser bundle; anything else here is read by the dev
# server or the build and stays on the machine.
#
# NOTHING SECRET BELONGS IN THIS FILE, OR IN ANY VITE_ VARIABLE. A VITE_
# value is compiled into the JavaScript every visitor downloads — treat each
# one as public. API keys, database URLs and auth secrets live on the server.
# =============================================================================

# -----------------------------------------------------------------------------
# Where the API lives.
#
# Leave this UNSET for local development: the dev server proxies /api to the
# backend (see vite.config.js), so the app's relative default — /api/v1 —
# works with no CORS involved.
#
# Set it for a deployed build, where the frontend and the API are different
# origins. Include the version prefix; no trailing slash. The API's own
# CORS_ORIGINS must list this app's origin, or the browser will refuse the
# response.
# -----------------------------------------------------------------------------
# VITE_API_BASE_URL=https://mulya-api.up.railway.app/api/v1

# -----------------------------------------------------------------------------
# Dev-server only. Where `npm run dev` forwards /api. Never bundled.
# -----------------------------------------------------------------------------
# API_PROXY_TARGET=http://localhost:4000
