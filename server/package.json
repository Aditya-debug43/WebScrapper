{
  "name": "mulya-server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Marketplace pricing intelligence API — persistence, analysis and recommendation services.",
  "scripts": {
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/scripts/migrate.ts",
    "db:seed": "tsx src/scripts/seed.ts",
    "db:verify": "tsx src/scripts/verify.ts",
    "db:reset": "tsx src/scripts/migrate.ts --reset",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "drizzle-orm": "^0.44.6",
    "pg": "^8.16.3",
    "postgres": "^3.4.7",
    "zod": "^4.1.12",
    "dotenv": "^17.2.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.11",
    "@types/node": "^24.6.2",
    "@types/pg": "^8.15.5",
    "drizzle-kit": "^0.31.5",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
