{
  "name": "mulya-server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Marketplace pricing intelligence API — persistence, analysis and recommendation services.",
  "scripts": {
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/scripts/migrate.ts",
    "db:seed": "tsx src/scripts/seed.ts",
    "db:verify": "tsx src/scripts/verify.ts",
    "db:reset": "tsx src/scripts/migrate.ts --reset",
    "typecheck": "tsc --noEmit",
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "test": "tsx --test tests/*.test.ts",
    "test:watch": "tsx --test --watch tests/*.test.ts",
    "db:migrate:prod": "node dist/scripts/migrate.js",
    "start:migrate": "node dist/scripts/migrate.js && node dist/server.js",
    "email:check": "tsx src/scripts/email-check.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/rate-limit": "^11.2.0",
    "argon2": "^0.45.1",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.44.6",
    "fastify": "^5.12.5",
    "nodemailer": "^10.0.11",
    "pg": "^8.16.3",
    "postgres": "^3.4.7",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.11",
    "@types/node": "^24.6.2",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.15.5",
    "drizzle-kit": "^0.31.5",
    "smtp-server": "^3.19.13",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22"
  }
}
