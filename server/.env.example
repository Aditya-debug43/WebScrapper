# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# pglite  — PostgreSQL 17 compiled to WebAssembly, in-process, no server to
#           install. The default for development and CI.
# postgres — a real server. Required in production; DATABASE_URL must be set.
DB_DRIVER=pglite
PGLITE_DATA_DIR=./.pglite

# Used only when DB_DRIVER=postgres. Never commit a real value.
# DATABASE_URL=postgresql://mulya:mulya@localhost:5432/mulya

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Migration from the legacy in-memory dataset (see scripts/export-dataset.mjs)
# ---------------------------------------------------------------------------
SEED_DATA_DIR=./seed-data
SEED_BATCH_SIZE=2000
