# =============================================================================
# Mulya API — environment
#
# Copy to .env and fill in. Every variable below is read by src/config/env.ts,
# validated at startup, and used somewhere; nothing here is aspirational.
# No real secret belongs in this file — it is committed.
# =============================================================================

NODE_ENV=development

# -----------------------------------------------------------------------------
# Database
#
# pglite   PostgreSQL 17 compiled to WebAssembly, in-process, no server to
#          install. The default for development and tests.
# postgres A real server. Required in production, and DATABASE_URL must be set.
# -----------------------------------------------------------------------------
DB_DRIVER=pglite
PGLITE_DATA_DIR=./.pglite

# Used only when DB_DRIVER=postgres. On Railway this is provided for you.
# DATABASE_URL=postgresql://mulya:mulya@localhost:5432/mulya

# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info

# Browser origins allowed to call this API, comma separated. The Vercel
# frontend and the Railway API are different origins, so this is load-bearing.
# Production refuses a wildcard and refuses plain http for non-localhost.
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# -----------------------------------------------------------------------------
# Authentication
#
# AUTH_SECRET is the server-side pepper for OTP and session-token hashing. A
# six-digit code has only a million possibilities, so a bare digest of one
# falls to a lookup table the moment the database leaks; an HMAC under a secret
# the database does not contain does not. Generate with:
#
#     node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
#
# Rotating it invalidates every outstanding code and every active session.
# -----------------------------------------------------------------------------
AUTH_SECRET=replace-me-with-at-least-32-random-characters

OTP_LENGTH=6
OTP_TTL_SECONDS=600
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_PER_EMAIL_PER_HOUR=5

SESSION_TTL_DAYS=30

# How long the token handed out by /auth/verify-reset-otp stays usable. It
# only has to cover "type a new password", so it is deliberately short.
RESET_TOKEN_TTL_SECONDS=900

# Returns the one-time code in the API response so tests and local development
# can complete the flow without an inbox. Production refuses to start with this
# enabled — a test convenience that can be switched on in production is a
# backdoor, not a convenience.
EXPOSE_OTP_IN_RESPONSE=false

# -----------------------------------------------------------------------------
# Email
#
# memory   captures messages in memory (tests)
# console  logs that a message was sent, to a masked address (development)
# http     posts to a transactional-email API
# smtp     a real mail server — Gmail, for receiving real codes locally
#
# `memory` and `console` deliver nothing and are refused in production.
# -----------------------------------------------------------------------------
EMAIL_ADAPTER=console
EMAIL_FROM=Mulya <no-reply@mulya.local>

# Required when EMAIL_ADAPTER=http. Provider-agnostic: any endpoint accepting
# { from, to[], subject, text } with a bearer token will work.
# EMAIL_API_URL=https://api.resend.com/emails
# EMAIL_API_KEY=

# -----------------------------------------------------------------------------
# SMTP — required when EMAIL_ADAPTER=smtp
#
# Gmail, for local development: fill these in and real verification and reset
# codes arrive in your own inbox. Startup refuses to continue if any of
# SMTP_HOST, SMTP_PORT, SMTP_USER or SMTP_PASS is missing, and it performs a
# real handshake so a wrong credential fails at boot rather than at signup.
#
# ── SMTP_PASS MUST BE A GOOGLE APP PASSWORD, NOT YOUR GMAIL PASSWORD ─────────
#
# Gmail rejects the account password over SMTP, and putting it here would put
# your whole Google account in a file. An App Password is scoped to this one
# application and can be revoked on its own. To create one:
#
#   1. Use a Gmail account set aside for application mail if you can.
#   2. Google Account → Security → turn on 2-Step Verification.
#   3. Google Account → Security → 2-Step Verification → App passwords.
#   4. Create one, name it "Mulya local", and copy the 16-character value.
#   5. Paste it into SMTP_PASS in your own .env — NEVER into this file.
#
# EMAIL_FROM must be the same address as SMTP_USER. Gmail will not send as an
# address the authenticated account does not own; it rewrites the header
# silently, so startup refuses the mismatch instead.
#
# Port 465 with SMTP_SECURE=true is implicit TLS and is the simplest working
# choice. Port 587 with SMTP_SECURE=false upgrades via STARTTLS and is the
# alternative if 465 is blocked on your network. Both are encrypted.
#
# EXPOSE_OTP_IN_RESPONSE must be false with this adapter — returning the code
# as well as mailing it would hide a broken send.
# -----------------------------------------------------------------------------
# EMAIL_ADAPTER=smtp
# EMAIL_FROM=your-address@gmail.com
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=your-address@gmail.com
# SMTP_PASS=replace-with-a-google-app-password

# -----------------------------------------------------------------------------
# Rate limiting  (per caller IP, per window)
# -----------------------------------------------------------------------------
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_SECONDS=60
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60

# -----------------------------------------------------------------------------
# Migration from the legacy in-memory dataset
# -----------------------------------------------------------------------------
SEED_DATA_DIR=./seed-data
SEED_BATCH_SIZE=2000

# -----------------------------------------------------------------------------
# Market data ingestion  (live competitor offers)
# -----------------------------------------------------------------------------
# Where offer data comes from. The rest of the backend holds a provider
# interface and never a provider, so changing this line changes the data
# source and nothing else.
#
#   none     ingestion disabled; the endpoint answers 503 rather than
#            pretending it looked and found nothing. The default.
#   serpapi  live Google Shopping results via SerpApi. Requires SERPAPI_KEY.
#   fixture  recorded responses from disk — tests and offline development.
#            Refused in production: replaying a recording would present old
#            prices as the current market.
#
# This one variable selects BOTH providers the system uses, because they are
# two endpoints of one vendor:
#
#   the SEARCH endpoint       identifies which product a query means, and
#                             returns one row per catalogue id
#   the PRODUCT endpoint      turns a catalogue id into the list of stores
#                             selling it, each with a merchant id and a price
#
# They are configured together deliberately. Split apart, a deployment could
# search with one vendor and read sellers from another, producing catalogue
# ids that the second vendor cannot resolve.
MARKET_DATA_PROVIDER=none

# SERVER-SIDE ONLY. The browser never receives this; it calls our ingestion
# route and this process calls the provider. Put the real value in .env (which
# is gitignored) or in the deployment's secret store — never in this file and
# never in any frontend env var.
# SERPAPI_KEY=

# How long a capture stays reusable. Within this window a repeat request for
# the same query returns the stored observations instead of spending another
# provider request; callers can override per request. 21600 = 6 hours.
MARKET_DATA_TTL_SECONDS=21600

# Per provider call. A capture makes one search call plus one per catalogue
# id, and the product endpoint is the slower of the two — a cold search from
# the production host measured 8.6s, which left the old 15s budget almost
# nothing and failed the first real capture there.
MARKET_DATA_TIMEOUT_MS=30000
MARKET_DATA_COUNTRY=in
MARKET_DATA_CURRENCY=INR
MARKET_DATA_MAX_RESULTS=40

# Recorded responses. Search fixtures sit directly in this directory, named
# after the query; product fixtures sit in `products/` and are named after the
# catalogue id, because that is what the product endpoint is asked for.
MARKET_DATA_FIXTURE_DIR=./fixtures/market-data

# WHAT A COMPETITIVE CAPTURE COSTS, stated because it is the main cost dial in
# this system and it is not obvious from anything else here.
#
# A product is published under SEVERAL catalogue ids, each exposing only two or
# three of its sellers. Measured against live data: one id returned 3 sellers,
# four ids returned 10. So a capture spends one SEARCH call to identify the
# product, then one PRODUCT call per catalogue id it opens — four by default.
#
# Four things keep that from multiplying:
#
#   - the market belongs to the PRODUCT, not to whoever asked for it, so fifty
#     people following one product cost one capture
#   - a capture is skipped entirely when the stored market is still fresh
#   - a product nobody follows and nobody has opened is never captured at all
#   - a refresh re-opens the catalogue ids already clustered onto the product,
#     so it pays no search call
#
# Reading a stored market costs nothing. `GET /products/:id/market` touches no
# provider; only `POST /products/:id/capture` and the scheduler spend.

# -----------------------------------------------------------------------------
# Market snapshot freshness
#
# A successful provider call is a reusable MARKET SNAPSHOT, shared by every
# user and every screen. These decide how long one stays usable, and together
# they are what keeps provider calls proportional to interest rather than to
# traffic.
# -----------------------------------------------------------------------------

# How fresh a SEARCH insists on being. Shorter than the general window because
# typing a query asks for the current market — but not zero, or pressing enter
# twice buys two calls for one question.
MARKET_DATA_SEARCH_TTL_SECONDS=900

# The floor under a deliberate "refresh prices" press. The button is not a
# licence to spend: inside this window it returns what is stored and says so.
MARKET_DATA_REFRESH_FLOOR_SECONDS=1800

# How long full response bodies are kept before pruning to hash-only. Bodies
# are what let an improved parser be re-run over what was really received, and
# what lets a tracked result be resolved server-side. They are also the bulk of
# the storage — roughly 150 KB per capture.
MARKET_DATA_BODY_RETENTION_DAYS=90

# Upper bound on products captured in one scheduled sweep. A ceiling on spend
# per run: the most-followed products go first and the rest wait an hour.
CAPTURE_SWEEP_MAX_PRODUCTS=50

# -----------------------------------------------------------------------------
# AI pricing layer
#
# Reasons over evidence we have already gathered; it is NEVER the source of a
# market fact. `none` is the default and is a complete, working configuration:
# the deterministic engine still produces a recommendation, labelled as
# deterministic rather than dressed up as a model's judgement.
#
# The provider is named only here and in `src/ai/index.ts`, so switching is a
# configuration change rather than a rewrite.
# -----------------------------------------------------------------------------
AI_PROVIDER=none                 # none | gemini | openai | anthropic
AI_MODEL=gemini-2.0-flash
# AI_API_KEY=                    # server-side only; never reaches the browser
AI_TIMEOUT_MS=20000
